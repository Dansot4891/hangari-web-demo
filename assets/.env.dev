# ------------------------------------------------------------
# 환경 변수 템플릿
#   이 파일을 복사해서 .env(prod) / .env.dev(dev, local)를 만든다.
#     cp .env.example .env
#     cp .env.example .env.dev
#   .env / .env.dev 는 gitignore 대상이라 각자 로컬에서 생성해야 한다.
#
#   키 이름은 lib/core/constants/dotenv/app_env_const.dart 와 1:1로 대응한다.
#   전부 dotenv.env[...]! 로 non-null 강제라 값이 비면 런타임에 터진다.
# ------------------------------------------------------------

# API 서버 주소 (EnvConfig.apiBaseUrl)
#   명세 v2.1 부터 모든 앱 API 가 /api/v1 접두사를 쓴다.
#   접두사까지 여기에 포함시킨다 — 코드에서는 붙이지 않는다.
#     예) BASE_URL=https://api.hangari.app/api/v1
BASE_URL=

# 이미지 · 동영상 등 미디어 CDN 주소
MEDIA_BASE_URL=

# 카카오 로그인 (KakaoSdk.init)
KAKAO_NATIVE_APP_KEY=
KAKAO_JAVASCRIPT_KEY=

# 네이버 지도 (FlutterNaverMap.init)
# NCP 콘솔 > Services > Application Services > Maps 에서 Application 등록 후
# "Dynamic Map" 을 체크하면 인증정보에서 Client ID 를 확인할 수 있다.
# 콘솔에 등록하는 패키지명 / 번들 ID 는 flavor 마다 다르므로 둘 다 등록해야 한다.
#   prod       → com.hihola.hangari
#   dev, local → com.hihola.hangari.dev
NAVER_MAP_CLIENT_ID=

# Sentry DSN — 비워두면 릴리즈 빌드에서 Sentry 초기화가 실패한다.
# 디버그 빌드에서는 Sentry 를 초기화하지 않으므로 더미 값이어도 무방하다.
SENTRY_DSN=
